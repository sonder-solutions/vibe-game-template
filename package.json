{
  "name": "game-template",
  "version": "1.0.0",
  "description": "Security-by-obscurity 2D game engine template",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "dev:flower": "vite --config flower.vite.config.ts",
    "dev:qr": "vite --config qr-code.vite.config.ts",
    "build": "tsc && vite build",
    "build:lib": "tsc && vite build --config lib.vite.config.ts",
    "build:flower": "npm run pack-assets && tsc && vite build --config flower.vite.config.ts",
    "build:qr": "tsc && vite build --config qr-code.vite.config.ts",
    "test": "vitest",
    "test:watch": "vitest watch",
    "pack-assets": "npx tsx scripts/pack-assets.ts"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.71",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "cbor-x": "^1.6.4",
    "glob": "^13.0.6",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "qrcode-generator": "^2.0.4"
  },
  "peerDependencies": {
    "sharp": "^0.35.3"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  }
}
